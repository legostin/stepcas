{
  "name": "stepcas",
  "version": "0.1.0",
  "description": "A computer algebra system that shows its work: exact answers with school-style step-by-step solutions in Russian and English.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "types",
    "docs",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.cjs",
    "bench": "node bench/run.mjs",
    "bench:verify": "bench/.venv/bin/python bench/verify.py",
    "lint": "eslint .",
    "snapshot": "node bench/snapshot.mjs",
    "snapshot:verify": "node bench/snapshot.mjs --verify bench/golden.json",
    "snapshot:update": "node bench/snapshot.mjs --fingerprints bench/golden.json",
    "format": "prettier --write \"src/**/*.js\" \"test/**/*.cjs\" \"bench/**/*.mjs\" \"scripts/**/*.mjs\" \"demo/**/*.{js,html,css}\" eslint.config.js",
    "format:check": "prettier --check \"src/**/*.js\" \"test/**/*.cjs\" \"bench/**/*.mjs\" \"scripts/**/*.mjs\" \"demo/**/*.{js,html,css}\" eslint.config.js",
    "types": "tsc -p tsconfig.types.json",
    "types:check": "npm run types && tsc -p test/types/tsconfig.json",
    "check": "npm run lint && npm run format:check && npm test && npm run types:check && npm run snapshot:verify",
    "prepare": "npm run types"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "cas",
    "computer-algebra",
    "math",
    "step-by-step",
    "equations",
    "calculus",
    "symbolic",
    "education",
    "russian"
  ],
  "author": "legostin (https://legost.in)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/legostin/stepcas.git"
  },
  "homepage": "https://legost.in/utilities/math/canvas",
  "sideEffects": false,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3"
  }
}
